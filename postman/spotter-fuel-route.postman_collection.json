              "console.log(`$${b.summary.total_fuel_cost} | ${b.summary.fuel_stops} stops | ${b.meta.elapsed_ms} ms | cache_hit=${b.meta.cache_hit}`);"
            ]
          }
        }
      ]
    },
    {
      "name": "Map view (open in browser)",
      "request": {
        "method": "GET",
        "description": "HTML Leaflet map of the same plan. Use the map_url field from any JSON response.",
        "url": {
          "raw": "{{baseUrl}}/api/v1/route-plan/map/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
