          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422', () => pm.response.to.have.status(422));",
              "pm.test('error code', () => pm.expect(pm.response.json().error).to.eql('no_feasible_fuel_plan'));"
            ]
          }
        }
