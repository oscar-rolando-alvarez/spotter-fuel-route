    {
      "name": "Error: outside USA",
      "request": {
        "method": "GET",
        "description": "Coordinates outside the USA are rejected.",
        "url": {
          "raw": "{{baseUrl}}/api/v1/route-plan/?start=48.8566,2.3522&finish=Denver, CO",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "route-plan",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "48.8566,2.3522"
            },
            {
              "key": "finish",
              "value": "Denver, CO"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));",
              "pm.test('error code', () => pm.expect(pm.response.json().error).to.eql('location_not_found'));"
            ]
          }
        }
