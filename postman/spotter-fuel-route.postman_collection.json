          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "route-plan",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            },
            {
              "key": "stop_penalty",
              "value": "0"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('at most one external API call', () => pm.expect(b.meta.external_api_calls).to.be.at.most(1));",
              "pm.test('has route geometry and cost', () => { pm.expect(b.route.geometry.type).to.eql('LineString'); pm.expect(b.summary.total_fuel_cost).to.be.a('number'); });",
              "pm.test('no leg exceeds 500 mi', () => { let prev = 0; for (const s of b.fuel_stops) { pm.expect(s.route_mile - prev).to.be.at.most(500.5); prev = s.route_mile; } pm.expect(b.summary.distance_miles - prev).to.be.at.most(500.5); });",
              "console.log(`$${b.summary.total_fuel_cost} | ${b.summary.fuel_stops} stops | ${b.meta.elapsed_ms} ms | cache_hit=${b.meta.cache_hit}`);"
            ]
          }
        }
      ]
    },
    {
      "name": "Coordinates input + half tank (Dallas → Chicago)",
      "request": {
        "method": "GET",
        "description": "lat,lng input (no geocoding at all) and a half-full tank at departure.",
        "url": {
          "raw": "{{baseUrl}}/api/v1/route-plan/?start=32.7767,-96.7970&finish=41.8781,-87.6298&start_fuel_gallons=25",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "route-plan",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "32.7767,-96.7970"
            },
            {
              "key": "finish",
              "value": "41.8781,-87.6298"
            },
            {
              "key": "start_fuel_gallons",
              "value": "25"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
